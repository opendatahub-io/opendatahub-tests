# =============================================================================
# Pipelines Components smoke test configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The .env file is loaded automatically and is in .gitignore.
# Environment variables set in the shell take precedence over .env values.
# =============================================================================

# ---------------------------------------------------------------------------
# Pipeline mode selection
# ---------------------------------------------------------------------------
# DEFAULT: Managed pipelines (leave YAML vars empty or unset).
# The DSPA operator auto-registers pipelines in KFP by display name.
# Tests discover them automatically — no YAML files needed.
#
# LEGACY: Set AUTOML_PIPELINE_YAML or AUTORAG_PIPELINE_YAML to a local path
# or URL to fall back to manual YAML upload.
# ---------------------------------------------------------------------------

# Pipeline YAMLs — leave empty for managed mode (default), set for legacy mode
#AUTOML_PIPELINE_YAML=
#AUTORAG_PIPELINE_YAML=

# Managed pipeline display names (override only if cluster uses different names)
#MANAGED_PIPELINE_AUTOML_TABULAR=autogluon-tabular-training-pipeline
#MANAGED_PIPELINE_AUTORAG=documents-rag-optimization-pipeline

# Managed pipelines image (optional — pin a specific pipelines-components image)
#MANAGED_PIPELINES_IMAGE=quay.io/rhoai/odh-pipelines-components-rhel9@sha256:...

# Post-DSPA-ready buffer before polling for managed pipelines (seconds)
#DSPA_READY_BUFFER_SECONDS=30

# Timeout for waiting until managed pipeline appears in KFP (seconds)
#MANAGED_PIPELINE_WAIT_TIMEOUT=300

# ---------------------------------------------------------------------------
# External S3 credentials (shared by AutoML and AutoRAG)
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# AutoML training data in external S3 (downloaded to built-in MinIO)
# ---------------------------------------------------------------------------
AUTOML_S3_BUCKET=
AUTOML_S3_TRAIN_DATA_KEY=

# ---------------------------------------------------------------------------
# AutoRAG test data in external S3 (downloaded to built-in MinIO)
# ---------------------------------------------------------------------------
AUTORAG_S3_BUCKET=
AUTORAG_INPUT_DATA_KEY=
AUTORAG_TEST_DATA_KEY=

# ---------------------------------------------------------------------------
# Models to deploy for AutoRAG (test deploys vLLM serving runtimes)
# URI can be S3 (s3://bucket/path) or HuggingFace (hf://org/model-name)
# ---------------------------------------------------------------------------
HF_TOKEN=
AUTORAG_INFERENCE_MODEL_URI=
AUTORAG_INFERENCE_MODEL_NAME=
AUTORAG_EMBEDDING_MODEL_URI=
AUTORAG_EMBEDDING_MODEL_NAME=

# LlamaStack catalog-compatible model ID for the inference model (optional).
#AUTORAG_LLAMA_STACK_INFERENCE_MODEL_ID=

# Embedding model max sequence length (default: 512, suitable for bge-base-en-v1.5)
#AUTORAG_EMBEDDING_MAX_MODEL_LEN=512

# Pipeline tuning (optional — defaults shown)
#AUTORAG_MAX_RAG_PATTERNS=4
#AUTORAG_OPTIMIZATION_METRIC=faithfulness
#AUTORAG_PIPELINE_TIMEOUT=3600

# Skip resource teardown after tests (keeps namespace alive for debugging)
#SKIP_TEARDOWN=false
